# before `uv sync` is available. Generated dependency tree -- never tracked.
# (The generic `bin/` rule below only hides its bin/; pyvenv.cfg and
# lib/site-packages need this explicit rule -- Phase A closure repair round 3.)
.venv-noam/
.tools/
.worktrees/
.ladybug_home/
__pycache__/
